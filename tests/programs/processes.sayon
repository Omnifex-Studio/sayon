# Running other programs
os = import("standard/os.sayon")
strings = import("standard/strings.sayon")
filesystem = import("standard/filesystem.sayon")

# A command line for the platform's command interpreter.
function shell(own command: string, directory = "") -> os.Completed
    if os.platform() == "windows"
        return os.run("cmd", ["/c", command], directory)
    return os.run("sh", ["-c", command], directory)

greeting = shell("echo hello")
print(greeting.status, strings.trim(greeting.output), greeting.errors == "")
failing = shell("exit 3")
print(failing.status)

folder = "processes_dir.tmp"
if not filesystem.exists(folder)
    filesystem.create_directory(folder)
here = "pwd"
if os.platform() == "windows"
    here = "cd"
inside = shell(here, folder)
print(strings.ends_with(strings.trim(inside.output), folder))
filesystem.remove(folder)

missing = try os.run("sayon-no-such-program", [])
if missing is error
    print(missing.code)

# What a program reads, and the environment it has.
sorted = os.run("sort", [], "", "pear\napple\nfig\n")
print(strings.split(strings.trim(strings.replace(sorted.output, "\r", "")), "\n"))
command = "echo $SAYON_GREETING"
if os.platform() == "windows"
    command = "echo %SAYON_GREETING%"
environment: Dict<string, string> = ["SAYON_GREETING" = "hi there"]
if os.platform() == "windows"
    greeted = os.run("cmd", ["/c", command], "", "", environment)
    print(strings.trim(greeted.output))
else
    greeted = os.run("sh", ["-c", command], "", "", environment)
    print(strings.trim(greeted.output))

# A program started without waiting: its output is read as it comes.
counting = os.start("sort", [])
for word in ["three", "one", "two"]
    counting.input.write_line(word)
counting.finish_input()
lines: Array<string> = []
while true
    line = counting.output.read_line()
    if line == nothing
        break
    push(lines, line)
print(lines, counting.wait(), counting.id() > 0)

# A program that would wait for its input forever can be stopped.
waiting = os.start("sort", [])
waiting.stop()
print(waiting.wait() != 0)

# Standard output as a file writes in order with `print`.
io = import("standard/io.sayon")
out = io.output()
print("before")
out.write_line("through the file")
print("after")
