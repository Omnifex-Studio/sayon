crypto = import("standard/crypto.sayon")
strings = import("standard/strings.sayon")

# FIPS 180-4's test vectors.
print(crypto.hex(crypto.sha256([])))
print(crypto.hex(crypto.sha256(strings.bytes("abc"))))
print(crypto.hex(crypto.sha256(strings.bytes("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))))
print(crypto.hex([0, 15, 16, 255]))

first = crypto.random_bytes(32)
second = crypto.random_bytes(32)
print(length(first), length(crypto.random_bytes(0)), not crypto.same(first, second))
print(crypto.same(first, clone(first)), crypto.same([1, 2], [1, 3]), crypto.same([1], [1, 1]))

result = try crypto.random_bytes(-1)
if result is error
    print(result.code)
