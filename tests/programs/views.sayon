numbers = [5, 3, 8, 1, 9, 2]
middle = view(numbers, 1, 4)
print(length(middle), middle[0], middle, numbers)

function total(values: View<integer>) -> integer
    sum = 0
    for value in values
        sum += value
    return sum

print(total(view(numbers)), total(middle), total(view(middle, 1, 3)))

# Changing elements through a mutable view.
function double_all(update values: MutableView<integer>)
    for index in range(length(values))
        values[index] = values[index] * 2

double_all(mutable_view(numbers, 0, 3))
print(numbers)

# A function may return a view of its parameter.
function first_half(items: Array<string>) -> View<string>
    return view(items, 0, length(items) / 2)

words = ["alpha", "beta", "gamma", "delta"]
half = first_half(words)
print(half, length(half))
copy = clone(half)
push(words, "epsilon")
print(copy, words)

# Views of owned elements borrow them.
names = ["Ada", "Grace", "Linus"]
some = view(names, 1)
for name in some
    print(name)
print(clone(some))

outcome = try total(view(numbers, 2, 10))
if outcome is error
    print(outcome.message)

# Splitting a view gives parts that can be used, and changed, together.
function add_into(update target: MutableView<integer>, source: MutableView<integer>)
    for index in range(length(target))
        target[index] += source[index]

pairs = [1, 2, 3, 10, 20, 30]
rest = mutable_view(pairs)
front = split_view(rest, 3)
add_into(rest, front)
front[0] = 100
print(length(front), length(rest))
print(pairs)

function negate_chunks(update values: MutableView<integer>, size: integer)
    while length(values) > 0
        count = size
        if length(values) < size
            count = length(values)
        chunk = split_view(values, count)
        chunk[0] = -chunk[0]

seven = [1, 2, 3, 4, 5, 6, 7]
negate_chunks(mutable_view(seven), 3)
print(seven)

letters = ["a", "b", "c"]
reading = view(letters)
head = split_view(reading, 1)
print(head, reading)
try
    split_view(reading, 5)
catch problem
    print(problem.code, problem.message)
print(reading)
