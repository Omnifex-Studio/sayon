# Strings, interpolation, and escapes
name = "Sayon"
print("Hello, {name}!")
print("Sum: {100 + 20}")
print("Braces: {{{name}}}")
print("Nested: {"inner {name}"}")
print("Tab:\tend")
print("Quote: \" and backslash: \\")
print("Unicode: \u{1F600} \u{e9}")

greeting = "héllo wörld"
print(length(greeting), bytelength(greeting))
print("abc" < "abd", "b" > "a", "same" == "same")
joined = "first" + " " + "second"
print(joined)
print(tostring(42) + "!")

# Positions and loops count characters, not bytes.
print(greeting[0], greeting[1], greeting[length(greeting) - 1])
letters = []
for character in greeting
    if character == " "
        break
    push(letters, character)
print(letters)
for character in "日本"
    print(character, bytelength(character))
outcome = try greeting[20]
if outcome is error
    print(outcome.code, outcome.message)
