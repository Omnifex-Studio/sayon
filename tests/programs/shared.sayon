# Shared values, weak handles, and cells

type Settings = [name: string, sizes: Array<integer>]

settings = share(Settings(name = "main", sizes = [1, 2, 3]))
other = settings
print(settings.value.name, other.value.sizes, length(settings.value.sizes))

function describe(shared: Shared<Settings>) -> string
    return "{shared.value.name}: {length(shared.value.sizes)}"

print(describe(settings), describe(other))

# Assigning, storing, and passing a handle retains it; both stay usable.
kept = [settings, other]
print(kept[1].value.name, length(kept))
function keep(own handle: Shared<Settings>) -> Array<Shared<Settings>>
    return [handle]

print(length(keep(settings)), settings.value.name)
by_name = ["main" = settings]
print(by_name["main"].value.sizes)
for handle in kept
    print(handle.value.name)

# `move` hands the handle over without retaining it.
moved = move(other)
print(moved.value.name)

# Shared state that changes lives in a cell.
counter = share(cell(0))

function bump(by: Shared<Cell<integer>>)
    by.value.set(by.value.get() + 1)

bump(counter)
alias = counter
bump(alias)
print(counter.value.get(), counter)

names = cell(["a"])
old = names.replace(["b", "c"])
print(old, names.get(), names)

# A closure keeps a handle of what it captures.
make_reader = function() -> function() -> integer
    held = share(cell(5))
    return function() -> integer
        held.value.set(held.value.get() + 1)
        return held.value.get()
read = make_reader()
print(read(), read())

# Weak handles do not keep a value alive.
weak = settings.weak()
found = weak.upgrade()
if found != nothing
    print("alive", found.value.name)

function dropped() -> Weak<string>
    local = share("temporary")
    return local.weak()

gone = dropped()
print(gone.upgrade() == nothing, gone)

# A tree whose children point back to their parent with weak handles, so
# that it is freed when the last outside handle goes.
type Node = [label: string, parent: Cell<Weak<Node> or nothing>, children: Cell<Array<Shared<Node>>>]

function node(label: string) -> Shared<Node>
    empty: Array<Shared<Node>> = []
    return share(Node(label = clone(label), parent = cell(nothing), children = cell(empty)))

function attach(parent: Shared<Node>, child: Shared<Node>)
    child.value.parent.set(parent.weak())
    children = parent.value.children.replace([])
    push(children, child)
    parent.value.children.set(children)

root = node("root")
leaf = node("leaf")
attach(root, leaf)
attach(root, node("other"))
up = leaf.value.parent.get()
if up != nothing
    above = up.upgrade()
    if above != nothing
        print(leaf.value.label, "is under", above.value.label)
print(length(root.value.children.get()))

# A union holding a handle is retained when it is copied.
maybe: Shared<Settings> or nothing = settings
second = maybe
if second != nothing
    print(second.value.name)
