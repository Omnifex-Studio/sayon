# Compile-time platform branches: only the branch the target selects is
# checked and compiled, so the others can name what this target lacks.

function on_an_iphone() -> boolean
    if platform == "ios"
        return iphone_model() != ""
    else
        return false

print(on_an_iphone())
print(supports("clock"), supports("json"))
print(processor == "x64" or processor == "arm64" or processor == "wasm32")

if not supports("console")
    console_is_missing()

# Outside conditions the names are plain values.
known = platform
print(length(known) > 0, typeof(processor))

# A name of the program's own is an ordinary value, even holding "web".
platform = "web"
if platform == "web"
    print("the program's own platform variable")
