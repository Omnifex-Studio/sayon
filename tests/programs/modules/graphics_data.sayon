# Generated by scripts/graphics_data.py: PNG images of each kind, with
# the digest of the pixels each holds (-1 for one that is damaged), and
# a small TrueType font, alone and in a collection.
strings = import("standard/strings.sayon")

type Sample = [name: string, hex: string, digest: integer]

function images() -> Array<Sample>
    samples: Array<Sample> = []
    push(samples, Sample(name = "gray 1-bit", hex = "89504e470d0a1a0a0000000d494844520000000d000000050100000000b6c35bbc0000001749444154789c63907060acfac6746c02f3d95d2cc61500259c055b06a317650000000049454e44ae426082", digest = 4629780))
    push(samples, Sample(name = "gray 2-bit", hex = "89504e470d0a1a0a0000000d494844520000000700000006020000000060d5c30b0000001a49444154789c63283bc258f08629c58779f53c963611868b16003c54063d6ba97cce0000000049454e44ae426082", digest = 2241960))
    push(samples, Sample(name = "gray 4-bit", hex = "89504e470d0a1a0a0000000d4948445200000009000000040400000000bc94a7130000002149444154789c63d87af3cb99058c7a5a554a7f987ec5bc58b68059cc9361d6710092280b293cddaabb0000000049454e44ae426082", digest = 1719924))
    push(samples, Sample(name = "gray 8-bit, a transparent gray", hex = "", digest = 5166204))
    push(samples, Sample(name = "gray 16-bit", hex = "89504e470d0a1a0a0000000d4948445200000005000000051000000000f894a57a0000004249444154789c013700c8ff00dfb8091a78d78597d100016cd44c2ebb28c9ce2c5802b157f4b38ac3d9f1812f034bdfc41838d0cd18ccae0416cae4e711736525d7b5d6761ae1347458840000000049454e44ae426082", digest = 818088))
    push(samples, Sample(name = "color 8-bit, stored", hex = "", digest = 7630033))
    push(samples, Sample(name = "color 16-bit, a transparent color", hex = "", digest = 634574))
    push(samples, Sample(name = "color 8-bit, interlaced, 3 by 2", hex = "89504e470d0a1a0a0000000d49484452000000030000000208020000016511c1db0000001f49444154789c6358fc9297f9f7095506911b7718b3d5dc6ed7a69a8a2c0500663e08d0208465fb0000000049454e44ae426082", digest = 48485))
    push(samples, Sample(name = "palette 1-bit", hex = "89504e470d0a1a0a0000000d494844520000000a00000003010300000090f30c3600000006504c544533368fc6165850d8a1640000001149444154789c63906460343dcdf4f3000007c402d68a0483f30000000049454e44ae426082", digest = 976394))
    push(samples, Sample(name = "palette 2-bit, interlaced, transparent", hex = "", digest = 6372687))
    push(samples, Sample(name = "palette 4-bit", hex = "", digest = 9341817))
    push(samples, Sample(name = "palette 8-bit, fixed codes", hex = "", digest = 85435241))
    push(samples, Sample(name = "gray and alpha 8-bit", hex = "89504e470d0a1a0a0000000d49484452000000060000000608040000004ac527c30000005949444154789c014e00b1ff002bedbd9042949a2371441e370184da702c15eb819cc05ac0a102d0fc6d6ceaaab1fb69eaf93e03b56b4644980371c4addb35e80449b700afd824aae5d2c96b0f00f4708b016a25f9edac87e29dd5dc2793a6a837a70000000049454e44ae426082", digest = 1304368))
    push(samples, Sample(name = "gray and alpha 16-bit", hex = "89504e470d0a1a0a0000000d49484452000000040000000310040000004e6dba0e0000003e49444154789c013300ccff00d87ac088e479c00f7c8a2bec97ed400201078067a2ae9c12c5acdb8db11b0c6c70025bcdedd67b42d10b87a5409719a5926982ee1866f51258c20000000049454e44ae426082", digest = 133654))
    push(samples, Sample(name = "color and alpha 8-bit, interlaced, in pieces", hex = "", digest = 321180014))
    push(samples, Sample(name = "color and alpha 16-bit", hex = "89504e470d0a1a0a0000000d4948445200000003000000021006000000cde4ba590000003d49444154789c013200cdff00651705bddff3cd0dbf1ae49c0293fbc1fb9ea05f6519dfc70122dd029480205b8d62f7dff13ae6b1b0f16b4bbac8df298787191ad198e988850000000049454e44ae426082", digest = 35192))
    push(samples, Sample(name = "color and alpha 8-bit, 1 by 1, interlaced", hex = "89504e470d0a1a0a0000000d49484452000000010000000108060000016812f41f0000000d49444154789c63480d5fdf0300048801f8e3e108dc0000000049454e44ae426082", digest = 1360))
    push(samples, Sample(name = "color and alpha 8-bit, repeating", hex = "", digest = 335937625))
    push(samples, Sample(name = "not an image", hex = "68656c6c6f2c20776f726c64", digest = -1))
    push(samples, Sample(name = "cut short", hex = "89504e470d0a1a0a0000000d494844520000000d000000050100000000b6c35bbc00000017494441", digest = -1))
    push(samples, Sample(name = "damaged", hex = "89504e470d0a1a0a0000000d494844520000000d400000050100000000b6c35bbc0000001749444154789c63907060acfac6746c02f3d95d2cc61500259c055b06a317650000000049454e44ae426082", digest = -1))
    push(samples, Sample(name = "a color its palette lacks", hex = "89504e470d0a1a0a0000000d49484452000000040000000104030000000b1212fe00000006504c544501020304050695536f480000000b49444154789c63600c040000560053803882670000000049454e44ae426082", digest = -1))
    push(samples, Sample(name = "an unknown chunk it needs", hex = "89504e470d0a1a0a0000000d494844520000000d000000050100000000b6c35bbc000000075a5a5a5a737472616e676564ac2e1e0000001749444154789c63907060acfac6746c02f3d95d2cc61500259c055b06a317650000000049454e44ae426082", digest = -1))
    return samples

function font() -> Array<byte>
    return unhex("")

function collection() -> Array<byte>
    return unhex("")

# The bytes hexadecimal digits spell, two digits a byte.
function unhex(text: string) -> Array<byte>
    digits = strings.bytes(text)
    out: Array<byte> = []
    index = 0
    while index + 1 < length(digits)
        push(out, unsigned8(digit(integer(digits[index])) * 16 + digit(integer(digits[index + 1]))))
        index += 2
    return out

private function digit(code: integer) -> integer
    if code >= 97
        return code - 87
    return code - 48
