# HTTP requests to the server the tests run at 127.0.0.1:47613 (see
# crates/cli/tests/fixtures.rs): over sockets, or in a web page through the
# browser's fetch, which lets a page read another site's responses since
# that server allows it. Each way gives the same responses.
network = import("standard/network.sayon")
strings = import("standard/strings.sayon")
threads = import("standard/threads.sayon")
time = import("standard/time.sayon")

base = "http://127.0.0.1:47613"

hello = network.get(base + "/hello")
print(hello.status, hello.reason, hello.text(), hello.header("X-Greeting"))
print(hello.header("x-missing"), hello.succeeded(), hello.url == base + "/hello")

# The values of a header sent twice, joined.
print(network.get(base + "/twice").header("x-twice"))
print(network.get(base + "/chunked").text())

moved = network.get(base + "/moved")
print(moved.status, moved.text(), moved.url == base + "/hello")

headers: Dict<string, string> = ["x-sayon" = "hi there"]
echoed = network.request("post", base + "/echo", headers, strings.bytes("some text"))
print(echoed.status, echoed.reason, echoed.text(), echoed.header("x-echo"))
print(network.post(base + "/echo", "more").text())

bytes = network.get(base + "/bytes").body
print(length(bytes), bytes[0], bytes[200], bytes[255])

missing = network.get(base + "/nowhere")
print(missing.status, missing.reason, missing.text(), missing.succeeded())

# A task waits for its response while the others run: the server answers
# "/later" half a second after it was asked.
later = base + "/later"
waiting = threads.spawn(function() -> string
    return network.get(later).text()
)
other = threads.spawn(function()
    time.sleep(time.milliseconds(50))
    print("another task ran meanwhile")
)
print(threads.join(waiting))
threads.join(other)

# What fails, with its code and message.
function failure(url: string, timeout: time.Duration, redirects: integer, limit: integer) -> string
    none: Dict<string, string> = []
    try
        response = network.request("GET", url, none, [], timeout, redirects, limit)
        return "no failure: {response.status}"
    catch problem
        return "{problem.code}: {problem.message}"

print(failure(base + "/large", time.seconds(30), 10, 10))
print(failure(base + "/moved", time.seconds(30), 0, 1000))
print(failure(base + "/later", time.milliseconds(100), 10, 1000))
print(failure(base + "/hello", time.seconds(30), 0, 11))
