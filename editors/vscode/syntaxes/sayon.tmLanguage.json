{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sayon",
  "scopeName": "source.sayon",
  "patterns": [
    {
      "include": "#block-comment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.sayon",
      "begin": "^\\s*##\\s*$",
      "end": "^\\s*##\\s*$"
    },
    "comment": {
      "name": "comment.line.number-sign.sayon",
      "match": "#.*$"
    },
    "function-definition": {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.sayon"
        },
        "2": {
          "name": "entity.name.function.sayon"
        }
      }
    },
    "type-definition": {
      "match": "\\b(type|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.sayon"
        },
        "2": {
          "name": "entity.name.type.sayon"
        }
      }
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#keyword-control"
        },
        {
          "include": "#keyword-declaration"
        },
        {
          "include": "#keyword-logical"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#builtin-type"
        },
        {
          "include": "#builtin-function"
        },
        {
          "include": "#type-name"
        },
        {
          "include": "#constant-name"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.sayon",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.sayon"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.sayon"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.sayon",
          "match": "\\\\(?:[\"\\\\nrt0]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.sayon",
          "match": "\\\\."
        },
        {
          "name": "constant.character.escape.brace.sayon",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.sayon",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.sayon"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.sayon"
            }
          },
          "contentName": "source.sayon",
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sayon",
          "match": "\\b0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*u?\\b"
        },
        {
          "name": "constant.numeric.binary.sayon",
          "match": "\\b0b[01](?:_?[01])*u?\\b"
        },
        {
          "name": "constant.numeric.octal.sayon",
          "match": "\\b0o[0-7](?:_?[0-7])*u?\\b"
        },
        {
          "name": "constant.numeric.float.sayon",
          "match": "\\b\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.sayon",
          "match": "\\b\\d(?:_?\\d)*u?\\b"
        }
      ]
    },
    "keyword-control": {
      "name": "keyword.control.sayon",
      "match": "\\b(if|elseif|else|while|for|in|break|continue|return|try|catch|finally|match|case)\\b"
    },
    "keyword-declaration": {
      "name": "storage.modifier.sayon",
      "match": "\\b(function|variable|constant|type|enum|import|public|private|own|update|foreign|unsafe|async|await|is)\\b"
    },
    "keyword-logical": {
      "name": "keyword.operator.logical.sayon",
      "match": "\\b(and|or|not)\\b"
    },
    "constant": {
      "name": "constant.language.sayon",
      "match": "\\b(true|false|nothing|null_pointer)\\b"
    },
    "builtin-type": {
      "name": "support.type.primitive.sayon",
      "match": "\\b(integer|integer8|integer16|integer32|integer64|unsigned|unsigned8|unsigned16|unsigned32|unsigned64|byte|float|float32|float64|boolean|string|pointer|c_string|c_char|c_uchar|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_size|c_ssize|c_float|c_double)\\b"
    },
    "builtin-function": {
      "name": "support.function.builtin.sayon",
      "match": "\\b(print|length|bytelength|typeof|assert|range|tonumber|tostring|push|pop|remove|swap|haskey|readfile|writefile|clone|share|cell|mutex|view|mutable_view|split_view|error|raise|move)\\b(?=\\s*\\()"
    },
    "type-name": {
      "name": "entity.name.type.sayon",
      "match": "\\b(?:Array|Dict|Error|Range|[A-Z][a-z0-9][A-Za-z0-9]*)\\b"
    },
    "constant-name": {
      "name": "variable.other.constant.sayon",
      "match": "\\b[A-Z][A-Z0-9_]*\\b"
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\(|<[A-Za-z_, <>]*>\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.sayon"
        }
      }
    },
    "operator": {
      "name": "keyword.operator.sayon",
      "match": "->|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|[-+*/%<>=]"
    }
  }
}
