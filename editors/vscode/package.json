{
  "name": "sayon",
  "displayName": "Sayon",
  "description": "Highlighting, diagnostics, completion, and navigation for the Sayon programming language",
  "version": "0.0.1",
  "publisher": "omnifex-studio",
  "license": "Apache-2.0 WITH LLVM-exception",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Omnifex-Studio/sayon"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sayon"
  ],
  "contributes": {
    "configuration": {
      "title": "Sayon",
      "properties": {
        "sayon.path": {
          "type": "string",
          "default": "sayon",
          "description": "The sayon program, which the extension runs as `sayon lsp` for diagnostics, completion, and navigation."
        }
      }
    },
    "commands": [
      {
        "command": "sayon.restartServer",
        "title": "Sayon: Restart the Language Server"
      }
    ],
    "languages": [
      {
        "id": "sayon",
        "aliases": [
          "Sayon",
          "sayon"
        ],
        "extensions": [
          ".sayon"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.png",
          "dark": "./images/file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "sayon",
        "scopeName": "source.sayon",
        "path": "./syntaxes/sayon.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[sayon]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "files.eol": "\n"
      }
    }
  }
}
