{
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "##",
      "##"
    ]
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((public|private)\\s+)?(function|if|elseif|else|while|for|try|catch|finally|match|case|enum|unsafe|foreign)\\b[^#]*$|^.*=\\s*function\\s*\\(.*\\)\\s*(->.*)?$",
    "decreaseIndentPattern": "^\\s*(elseif|else|catch|finally)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(return|break|continue)\\b.*$",
      "action": {
        "indent": "outdent"
      }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?u?"
}
