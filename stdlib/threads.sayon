# Tasks that run together, and channels between them.
#
#     threads = import("standard/threads.sayon")
#     channel: Channel<string> = threads.new_channel()
#     sender = threads.spawn(function()
#         threads.send(channel, "hello")
#     )
#     print(threads.receive(channel))
#     threads.join(sender)
#
# Tasks are fibers: they take turns on one thread, and one runs until it
# waits, for a message, for room in a channel, for another task, for time
# to pass, or in `pause`. A spawned task starts when the task that spawned
# it first waits. A task owns what its function captured; a channel is a
# handle that every copy refers to, so the tasks holding it share it.
#
# When the program's main task finishes, the tasks still running are
# cancelled: each stops where it waits, with its `finally` blocks and
# cleanup, which `catch` and `try` do not stop. A task that failed without
# being joined makes the program fail after it reports the error. A task
# whose handle is dropped without a `join` is cancelled; `detach` lets it
# run on instead. Waiting when no other task can run raises DeadlockError.

time = import("standard/time.sayon")

# What `receive_result` gives: a message, or the end of a closed channel.
enum ReceiveResult<T>
    message(value: T)
    closed

# What `recoverable_send` gives: the message was sent, or it comes back with
# the error that kept it from being sent.
enum SendResult<T>
    sent
    unsent(message: T, problem: Error)

# A channel can hold this many messages without a limit being reached.
private constant UNBOUNDED = 9223372036854775807

# Starts a task running `body`, and gives its handle.
function spawn<T>(own body: function() -> T) -> Task<T>
    return task_spawn(body)

# Waits for a task to finish and gives its result. When the task failed,
# fails with its error.
function join<T>(own task: Task<T>) -> T
    return task_join(task)

# Lets a task run on without a handle. The program still waits for it to
# finish, or cancels it, when the main task ends.
function detach<T>(own task: Task<T>)
    task_detach(task)

# Lets the other tasks that are ready run before this one continues.
function pause()
    task_yield()

# A channel of messages, kept in the order they were sent. Up to
# `capacity` messages wait in it; then `send` waits for room. A capacity of
# 0 makes each `send` wait until its message is received.
function new_channel<T>(capacity = 64) -> Channel<T>
    return channel_new(capacity)

# A channel without a limit, so that `send` never waits for room. The
# messages that wait in it take memory without bound, so prefer a limit
# when senders can outpace receivers.
function new_unbounded_channel<T>() -> Channel<T>
    return channel_new(UNBOUNDED)

# Sends a message, waiting while the channel is full. Fails with
# ChannelClosedError when the channel is closed; the message is then destroyed.
function send<T>(channel: Channel<T>, own message: T)
    channel_send(channel, message)

# Sends a message like `send`, but when the channel is closed, gives the
# message back as `unsent(message, problem)` instead of destroying it.
function recoverable_send<T>(channel: Channel<T>, own message: T) -> SendResult<T>
    return channel_send_result(channel, message)

# The next message, waiting while the channel is empty. Fails with
# ChannelClosedError when the channel is closed and has none left.
function receive<T>(channel: Channel<T>) -> T
    return channel_receive(channel)

# The next message, or `closed` at the end of a closed channel, which tells
# the end apart from any message.
function receive_result<T>(channel: Channel<T>) -> ReceiveResult<T>
    outcome = try channel_receive(channel)
    if outcome is error
        if outcome.code == "ChannelClosedError"
            return closed
        raise(outcome)
    return message(outcome)

# A channel that receives `message` once `delay` has passed: a timer, which
# `select` waits for along with other channels, so that waiting for a
# message can end when it takes too long.
function after<T>(delay: time.Duration, own message: T) -> Channel<T>
    timer: Channel<T> = new_channel(1)
    # The message waits in a channel of its own until it is due.
    holding: Channel<T> = new_channel(1)
    send(holding, message)
    detach(spawn(function()
        time.sleep(delay)
        match recoverable_send(timer, receive(holding))
            case sent
                return
            case unsent(_, _)
                return
    ))
    return timer

# Closes a channel: no more messages can be sent, and receivers get the
# ones already sent and then ChannelClosedError.
function close<T>(channel: Channel<T>)
    channel_close(channel)

# Waits until one of the channels has a message or is closed and empty,
# receives from it, and calls `handler` with the message and the channel's
# position. A closed, empty channel fails with ChannelClosedError. When several
# are ready, the choice goes round, starting after the last one this task
# chose.
function select<T>(channels: Array<Channel<T>>, update handler: function(own T, integer))
    position = channel_select(channels)
    handler(channel_receive(channels[position]), position)
